# Cle longue et aleatoire (50 caracteres ou plus) ; en production : DEBUG=False
SECRET_KEY=
DEBUG=False

# Domaines autorises a appeler l'API depuis un navigateur (separes par des virgules)
CORS_ALLOWED_ORIGINS=https://lapered.com,https://www.lapered.com,https://salam-logistics.com,https://www.salam-logistics.com
# ALLOWED_HOSTS='localhost','127.0.0.1','10.0.2.2'

# Base de donnees : DB_ENGINE=postgresql (developpement) ou mysql (production cPanel)
DB_ENGINE=postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Database (MongoDB Atlas)
MONGO_URI=
MONGO_HOST=
MONGO_PORT=27017
MONGO_DB_NAME=
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Email (SMTP)
EMAIL_HOST=mail.otl-bulkliquid.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=contact@otl-bulkliquid.com
EMAIL_HOST_PASSWORD=
# Facultatif : expediteur affiche (par defaut : PERED <EMAIL_HOST_USER>)
# DEFAULT_FROM_EMAIL=PERED <contact@otl-bulkliquid.com>

# Facultatif : adresse du site placee dans les emails (par defaut : https://salam-logistics.com)
